# Exclusive env for mongodb-api + Vue admin-panel.
# Copy to .env.admin (never commit .env.admin).
# In Dokploy, paste the same keys into that compose's Environment.

# Same LibreChat database.
# Local host (npm run dev): mongodb://127.0.0.1:27017/LibreChat
# Docker compose network: mongodb://mongodb:27017/LibreChat
# Dokploy standalone: mongodb://chat-mongodb:27017/LibreChat
MONGODB_URI=mongodb://127.0.0.1:27017/LibreChat

# Option A (K8s-ready): optional split. If unset, reads use MONGODB_URI / primary.
# MONGODB_URI_PRIMARY=mongodb://mongo-primary:27017/LibreChat
# MONGODB_URI_READ=mongodb://mongo-replica:27017/LibreChat

# Required. Do not use the fallback values shipped in mongodb-api/config/db.js
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional machine-to-machine bypass for mongodb-api (the Vue panel does not use it)
# SERVICE_TOKEN=

# Host ports (Dokploy / local publish)
ADMIN_PANEL_PORT=5173
MONGODB_API_PORT=8082
