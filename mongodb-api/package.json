{
  "name": "mongodb-rest-api",
  "version": "1.0.0",
  "description": "Simple MongoDB REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "seed:sanitize": "node scripts/seed.js --reset --sanitize",
    "test": "node --test --test-concurrency=1 scripts/test-pagination.js tests/**/*.test.js",
    "test:unit": "node scripts/test-pagination.js",
    "test:crud": "node --test --test-concurrency=1 tests/**/*.test.js",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "mongodb",
    "rest",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0"
  }
}
